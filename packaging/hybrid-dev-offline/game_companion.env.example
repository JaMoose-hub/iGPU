# Game Companion Hybrid Dev
# Option B: each developer installs/configures Hermes separately.
# This file only tells Game Companion how to call the local Hermes environment.

HERMES_WSL_DISTRO=Ubuntu-24.04
HERMES_USE_CONFIG_MODEL=1
HERMES_AGENT_WEB_ENABLED=1
HERMES_AGENT_TOOLSETS=web
HERMES_TIMEOUT_SECONDS=900
HERMES_MAX_TOKENS=160
HERMES_AGENT_MAX_TOKENS=360
HERMES_CONTEXT_LENGTH=65536

# Display/model label used by the Game Companion backend health response.
LLAMA_MODEL_ALIAS=gpt-5.5-hermes

# Local Qwen3.5-4B router for GamePath routing/retrieval evaluation.
IGPU_LOCAL_ROUTER_TIMEOUT=8
IGPU_LOCAL_ROUTER_GAMEPATH_MAX_CHARS=280
IGPU_LOCAL_ROUTER_CACHE_TTL=600

# If your Hermes setup uses a custom OpenAI-compatible endpoint, uncomment and edit.
# HERMES_BASE_URL=http://127.0.0.1:9000/v1
