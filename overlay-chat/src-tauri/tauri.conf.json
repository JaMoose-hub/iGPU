{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "overlay-chat",
  "version": "0.1.0",
  "identifier": "com.james.overlay-chat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "overlay-chat",
        "width": 720,
        "height": 760,
        "minWidth": 460,
        "minHeight": 560,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true
      },
      {
        "label": "hud",
        "title": "game-guidance-hud",
        "url": "hud.html",
        "x": -32000,
        "y": -32000,
        "width": 1,
        "height": 1,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focusable": false,
        "visible": false,
        "resizable": false
      },
      {
        "label": "tasks",
        "title": "game-task-log",
        "url": "tasks.html",
        "x": -32000,
        "y": -32000,
        "width": 380,
        "height": 560,
        "minWidth": 340,
        "minHeight": 420,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": true
      },
      {
        "label": "search",
        "title": "game-search",
        "url": "search.html",
        "x": -32000,
        "y": -32000,
        "width": 960,
        "height": 720,
        "minWidth": 620,
        "minHeight": 520,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": true
      },
      {
        "label": "gamepath",
        "title": "gamepath-viewer",
        "url": "gamepath.html",
        "x": -32000,
        "y": -32000,
        "width": 520,
        "height": 620,
        "minWidth": 420,
        "minHeight": 460,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": true
      },
      {
        "label": "tools",
        "title": "game-tools-panel",
        "url": "tools.html",
        "x": -32000,
        "y": -32000,
        "width": 320,
        "height": 430,
        "minWidth": 300,
        "minHeight": 360,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": true
      },
      {
        "label": "standby",
        "title": "game-companion-standby",
        "url": "standby.html",
        "x": -32000,
        "y": -32000,
        "width": 260,
        "height": 460,
        "minWidth": 40,
        "minHeight": 80,
        "transparent": true,
        "backgroundColor": "#00000000",
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
